{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "WebWorker"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": ["./worker-configuration.d.ts", "node", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "workers/**/*.ts", "tests/**/*.ts", "worker-configuration.d.ts"]
}
