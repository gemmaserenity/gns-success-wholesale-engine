{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gns-success-wholesale-engine",
  "main": "workers/api/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "wholesale.gns-success.com", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./apps/dashboard/public",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "production",
    "MAX_CSV_BYTES": "2097152",
    "MAX_PAID_ENRICHMENT_CENTS": "500",
    "MAX_SKIP_TRACE_CENTS": "1000"
  }
}
