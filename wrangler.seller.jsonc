{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gns-success-seller-portal",
  "main": "workers/seller/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "sell.gns-success.com", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./apps/seller-portal/public",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "ratelimits": [
    {
      "name": "SELLER_INTAKE_RATE_LIMIT",
      "namespace_id": "240823007",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    "CALCOM_EVENT_TYPE_ID": "6772856",
    "CALCOM_SELLER_BOOKING_URL": "https://cal.com/gns-success/30min",
    "RESEND_FROM_EMAIL": "GNS Success <seller-portal@gns-success.com>"
  }
}
